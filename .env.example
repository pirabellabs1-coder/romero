# ──────────────────────────────────────────────────────────────────────
# Romero Photography — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# ──────────────────────────────────────────────────────────────────────

# Secret used to sign auth cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Public site URL (used for sitemap, OG tags, canonical links, email footer)
NEXT_PUBLIC_SITE_URL=https://romerophotography.fr

# ──────────────────────────────────────────────────────────────────────
# EMAIL — Resend (PRIMARY provider, recommended)
# ──────────────────────────────────────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Verify a domain (or use the test domain "onboarding@resend.dev")
# 3. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# "From" address. With your own verified domain:
#   MAIL_FROM=Romero Photography <hello@romerophotography.fr>
# Without verified domain (testing only):
#   MAIL_FROM=Romero Photography <onboarding@resend.dev>
MAIL_FROM=Romero Photography <onboarding@resend.dev>

# Where to deliver contact-form notifications.
# If empty, falls back to contact_email stored in admin settings.
# For testing now:
MAIL_TO=gildaslissanon0@gmail.com

# ──────────────────────────────────────────────────────────────────────
# EMAIL — SMTP fallback (optional — only used if Resend fails or absent)
# ──────────────────────────────────────────────────────────────────────
# Gmail: use an app password (https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# OVH:
#   SMTP_HOST=ssl0.ovh.net
#   SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
